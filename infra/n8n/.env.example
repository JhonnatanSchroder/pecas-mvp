# Copie este arquivo para .env e substitua todos os valores change-this-*.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-this-local-postgres-password
N8N_POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=change-this-local-n8n-encryption-key
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

LARAVEL_INTEGRATIONS_URL=http://host.docker.internal:8000/api/integrations
LARAVEL_INTEGRATION_TOKEN=change-this-laravel-integration-token
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=change-this-waha-api-key
WAHA_DASHBOARD_USERNAME=change-this-waha-dashboard-username
WAHA_DASHBOARD_PASSWORD=change-this-waha-dashboard-password
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=change-this-waha-webhook-secret
